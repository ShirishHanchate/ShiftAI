# Supabase project URL, e.g. https://abcdefgh.supabase.co (server-side only)
SUPABASE_URL=
# Supabase service-role key or new-style secret key (sb_secret_...). SERVER-SIDE ONLY.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Sarvam AI API subscription key (server-side only)
SARVAM_API_KEY=

# Optional: Session pooler connection string, used only by `npm run db:migrate` (contains the DB password)
SUPABASE_DB_URL=
