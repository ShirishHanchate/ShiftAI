{
  "name": "shiftsync-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "check:safety": "tsx --conditions=react-server scripts/check-extraction-safety.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "live:extract": "tsx --conditions=react-server scripts/live-extraction.ts",
    "live:agent": "tsx --conditions=react-server scripts/live-agent.ts",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --conditions=react-server --import tsx --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "live:transcribe": "tsx scripts/live-transcribe.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
